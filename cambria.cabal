cabal-version:      2.4
name:               cambria
version:            0.1.0.0

synopsis:           A simple interpreter for a parameterized effect and handler based language.
description:        Cambria is a project demonstrating type inference and evaluation for a
                    functional programming language with parameterized algebraic effects and handlers.
license:            MIT
author:             Jack Liell-Cock
maintainer:         jackliellcock@gmail.com
-- bug-reports:
copyright:          2025 Jack Liell-Cock
-- extra-source-files: CHANGELOG.md

-- Everything the interpreter itself needs.
common interpreter
  default-language: Haskell2010

  other-modules:
    Types
    Syntax
    Environment
    Semantics
    Runtime
    Parsing.Token
    Parsing.Parser
    Parsing.Lexer
    Parsing.SugaredSyntax
    Parsing.Desugar
    Inference.Monad
    Inference.Infer
    Inference.Context
    Inference.Substitutable
    Inference.Unify
    Inference.Effects

  build-depends:
    base >= 4.16.4.0,
    containers >= 0.6.5.1,
    random >= 1.3.1,
    mtl >= 2.3.1,
    array >= 0.5

common tooling
  build-tool-depends:
    alex:alex >= 3.2,
    happy:happy >= 1.20

executable cambria
  import:           interpreter, tooling
  main-is:          Main.hs
  hs-source-dirs:   src

-- Playground interpreter, compiled with the GHC wasm backend (reactor mode).
-- Needs native alex/happy on PATH.  Build via web/wasm/build.sh.
-- web/wasm comes first so main-is picks up its Main.hs, not the one in src.
executable cambria-wasm
  import:           interpreter
  main-is:          Main.hs
  hs-source-dirs:   web/wasm, src

  if arch(wasm32)
    build-depends: ghc-experimental
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor
      -optl-Wl,--export=hs_init,--export=runCambria
  else
    buildable: False

test-suite cambria-test
  import:           interpreter, tooling
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test, src

  build-depends:
    directory >= 1.3,
    filepath >= 1.4

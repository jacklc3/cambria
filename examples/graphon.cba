-- Erdos-Renyi graphon
with [$loc -> Name] handler {
  return x    -> return (fun _ -> return x),
  get a k     -> return (fun s -> k (s a) s),
  set (a,x) k -> return (fun s -> k () (fun b -> if a == b then return x else s b)),
  ref x k     -> do a <- !fresh () in return (fun s ->
                   k a (fun b -> if a == b then return x else s b)),
  finally s   -> s (fun _ -> return empty)
} handle (
  with handler {
    newgraph z k -> k (!ref empty),
    newnode z k -> k (!fresh ()),
    isedge (g, (a, b)) k ->
      do m <- !get g in
      if member ((a,b), m) then
        k (lookup ((a,b), m))
      else if member ((b,a), m) then
        k (lookup ((b,a), m))
      else
        do e <- !flip () in
        do _ <- !set (g, insert (((a,b),e), m)) in
        k e
  } handle (
    -- Make a new graph, pick three nodes, and check for a triangle
    do g <- !newgraph () in
    do a <- !newnode g in
    do b <- !newnode g in
    do c <- !newnode g in
    do e1 <- !isedge (g,(a,b)) in
    do e2 <- !isedge (g,(b,c)) in
    do e3 <- !isedge (g,(a,c)) in
    if e1 then (if e2 then return e3 else return false) else return false
  )
)

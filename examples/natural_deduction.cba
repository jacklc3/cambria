-- Natural-deduction proof search, as a logic program over generic effects
-- cf. An algebraic presentation of predicate logic, FoSSaCS 2013
--
-- The paper's SML prototype (Appendices A.4, A.5) searches for proofs in the
-- implicational fragment of propositional logic, over the four generic effects
-- of disjunctive predicate logic.  Formulas are arbitrary first-order terms,
-- so the parameter carries general unification.  A term is a Name into a heap
-- Map Name Node, where
--
--     Node = (Unit + Name) + (Str * List Name)
--       inl (inl ())   an unbound logic variable
--       inl (inr w)    a variable linked to w        (union-find)
--       inr (l, args)  the constructor l applied to sub-term names
--
-- The fuel argument bounds the search depth, so the unprovable Q3 terminates.

effect !cons   : Str * List $p ~> $p.   -- constructor: label + sub-term list
effect !free   : Unit    ~> $p.         -- E : fresh logic variable
effect !eq     : $p * $p ~> Unit.       -- unify
effect !bottom : Unit    ~> Void.       -- fail
effect !or     : Unit    ~> Bool.       -- choose

-- ---- generic list helpers ----

let rec append (xs, ys) = case xs of {
  []       -> return ys,
  x :: xs' -> x :: append (xs', ys)
} in
let rec mapC (f, xs) = case xs of {
  []       -> return [],
  x :: xs' -> f x :: mapC (f, xs')
} in
let rec take (n, xs) =
  if n == 0 then return []
  else case xs of {
    []       -> return [],
    x :: xs' -> x :: take (n - 1, xs')
  } in
let rec elem (x, ys) = case ys of {
  []       -> return false,
  y :: ys' -> if x == y then return true else elem (x, ys')
} in
let rec dedup (seen, xs) = case xs of {
  []       -> return [],
  x :: xs' -> if elem (x, seen) then dedup (seen, xs')
              else x :: dedup (x :: seen, xs')
} in
let rec flat xs = case xs of {
  []       -> return [],
  x :: xs' -> append (x, flat xs')
} in

-- ---- the heap: general first-order unification ----

let rec walk (n, h) = case lookup (n, h) of {
  inl (inr w) -> walk (w, h),
  _           -> return n
} in
let rec occurs v todo h = case todo of {
  []        -> return false,
  n :: rest ->
    do rn <- walk (n, h) in
    if rn == v then return true
    else case lookup (rn, h) of {
      inl _  -> occurs v rest h,
      inr la -> occurs v (append (snd la, rest)) h
    }
} in
let rec zipPairs (xs, ys) = case (xs, ys) of {
  ([], [])             -> return (inr []),
  (x :: xs', y :: ys') -> case zipPairs (xs', ys') of {
                            inl _  -> return (inl ()),
                            inr ps -> return (inr ((x, y) :: ps))
                          },
  _                    -> return (inl ())
} in
-- uni: unify a worklist of Name pairs.  Returns inl () on clash, inr h' on success.
let rec uni (pairs, h) = case pairs of {
          [] -> return (inr h),
          (a, b) :: rest ->
            do ra <- walk (a, h) in do rb <- walk (b, h) in
            if ra == rb then uni (rest, h)
            else case lookup (ra, h) of {
              inl _  -> bindVar ra rb rest h,
              inr la -> case lookup (rb, h) of {
                inl _  -> bindVar rb ra rest h,
                inr lb ->
                  if fst la == fst lb then
                    case zipPairs (snd la, snd lb) of {
                      inl _  -> return (inl ()),
                      inr ps -> uni (append (ps, rest), h)
                    }
                  else return (inl ())
              }
            }
        },
        bindVar v t rest h =
          if occurs v (t :: []) h then return (inl ())
          else uni (rest, insert ((v, inl (inr t)), h))
in
-- reify a term name, or a list of argument names, back to a string
let rec showT (n, h) =
          do rn <- walk (n, h) in
          case lookup (rn, h) of {
            inl _  -> return ("_" ++ hash rn),
            inr la -> case snd la of {
              [] -> return (fst la),
              _  -> fst la ++ "(" ++ showArgs (snd la, h) ++ ")" } },
        showArgs (xs, h) = case xs of {
          []       -> return "",
          x :: []  -> showT (x, h),
          x :: xs' -> showT (x, h) ++ ", " ++ showArgs (xs', h) }
in

-- ---- the free-model handler over the heap, parameterized by !or's strategy ----

let mkEngine or' = handler {
  return xs   -> return (fun h -> mapC ((fun n -> showT (n, h)), xs) :: []),
  bottom _ k  -> return (fun h -> return []),
  or _ k      -> or' k,
  eq (a, b) k -> return (fun h -> case uni ((a, b) :: [], h) of {
                   inl _  -> return [],
                   inr h' -> k () h'
                 }),
  free _ k    -> return (fun h -> do v <- !fresh () in k v (insert ((v, inl (inl ())), h))),
  cons (l, args) k -> return (fun h -> do c <- !fresh () in k c (insert ((c, inr (l, args)), h))),
  finally f   -> f empty
} in

-- angelic: keep the first branch that yields a solution
let angelic k h    = case k true h of { [] -> k false h, r1 -> return r1 } in
-- exhaustive: collect every solution (finite because the search is depth-bounded)
let exhaustive k h = append (k true h, k false h) in

let solve q    = with [$p -> Name] (mkEngine angelic)    handle (q ()) in
let solveAll q = with [$p -> Name] (mkEngine exhaustive) handle (q ()) in

-- ---- the proof searcher (SML prototype, Appendix A.4) ----

let atom s = !cons (s, []) in
let infixr 0 a => b = !cons ("=>", a :: b :: []) in

let rec member (ps, p) = case ps of {
  []       -> !bottom () ; return (),
  x :: xs' -> if !or () then !eq (x, p) else member (xs', p)
} in
let rec ded fuel ps p =
  if fuel == 0 then (!bottom () ; return ())
  else if !or () then member (ps, p)                             -- axiom
  else if !or () then                                            -- =>-introduction
    do q <- !free () in do r <- !free () in
    !eq (p, q => r) ;
    ded (fuel - 1) (q :: ps) r
  else                                                           -- =>-elimination
    do q <- !free () in
    ded (fuel - 1) ps (q => p) ;
    ded (fuel - 1) ps q
in

-- Q1:  |- p -> p
do q1 <- solve (fun _ ->
  do p <- atom "p" in
  do goal <- p => p in
  ded 3 [] goal ; return (goal :: [])) in

-- Q2:  p->q, q->r  |-  p->r     (transitivity of implication)
do q2 <- solve (fun _ ->
  do p <- atom "p" in do q <- atom "q" in do r <- atom "r" in
  do goal <- p => r in
  ded 6 ((p => q) :: (q => r) :: []) goal ; return (goal :: [])) in

-- Q3:  |- p -> q     (not a tautology: no proof within the depth bound)
do q3 <- solve (fun _ ->
  do goal <- atom "p" => atom "q" in
  ded 4 [] goal ; return (goal :: [])) in

-- Q4:  find a hypothesis  a  under which  a |- p->q     (first witness)
do q4 <- solve (fun _ ->
  do goal <- atom "p" => atom "q" in
  do a <- !free () in
  ded 4 (a :: []) goal ; return (a :: [])) in

-- Q5:  enumerate several such hypotheses (bounded, de-duplicated, first 6)
do q5raw <- solveAll (fun _ ->
  do goal <- atom "p" => atom "q" in
  do a <- !free () in
  ded 3 (a :: []) goal ; return (a :: [])) in
do q5 <- take (6, dedup ([], flat q5raw)) in

return (
  ("|- p->p",                q1) ::
  ("p->q, q->r |- p->r",     q2) ::
  ("|- p->q  (unprovable)",  q3) ::
  ("?a. a |- p->q",          q4) ::
  ("?a. a |- p->q (many)",   q5 :: []) :: []
)

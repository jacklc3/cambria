-- Two-cluster random graph: nodes are connected iff they fall in the same cluster
-- cf. Probabilistic programming interfaces for random graphs, POPL 2024
with [$graph -> Name, $node -> Bool] handler {
  newgraph _ k -> k (!fresh ()),
  newnode _ k -> k (!flip ()),
  isedge (_, (a, b)) k -> k (a == b)
} handle

effect !newgraph : Unit ~> $graph.
effect !newnode : $graph ~> $node.
effect !isedge : $graph * ($node * $node) ~> Bool.
-- Make a new graph, pick two nodes, and check an edge between them
do g <- !newgraph () in
do a <- !newnode g in
do b <- !newnode g in
!isedge (g, (a,b))

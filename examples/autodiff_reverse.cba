-- Continuation-based reverse-mode automatic differentiation
--
-- The theorey {const, neg, plus, mult} over a carrier is instantiated at a value
-- paired with a backpropagator rather than with a tangent.
--
-- Two operations cross a carrier boundary: !lift interprets the value
-- with tangent 0 and !seed with tangent 1.

-- componentwise addition of gradient vectors, at whichever carrier is in scope
do vplus <- return (fun ((a, b), (c, d)) ->
  do p <- !plus (a, c) in
  do q <- !plus (b, d) in
  return (p, q)
) in

-- f (x, y) = 1 + x^3 + (- y^2)
do f <- return (fun (x, y) ->
  do x3  <- !mult (!mult (x, x), x) in
  do y2  <- !mult (y, y) in
  do one <- !const 1 in
  !plus (!plus (one, x3), !neg y2)
) in

do reverse <- return (handler {
  return v      -> return v,
  const c k     -> k (!const c, fun z -> do o <- !const 0 in return (o, o)),
  neg (x, dx) k -> k (!neg x, fun z -> dx (!neg z)),
  plus ((x, dx), (y, dy)) k ->
    k (!plus (x, y), fun z -> vplus (dx z, dy z)),
  mult ((x, dx), (y, dy)) k ->
    k (!mult (x, y), fun z -> vplus (dx (!mult (y, z)), dy (!mult (x, z)))),
  lift  v k     -> k (v, fun z -> do o <- !const 0 in return (o, o)),
  seedx v k     -> k (v, fun z -> do o <- !const 0 in return (z, o)),
  seedy v k     -> k (v, fun z -> do o <- !const 0 in return (o, z))
}) in

with [$r -> Int] handler {
  return v      -> return v,
  const c k     -> k c,
  neg p k       -> k (0 - p),
  plus (a, b) k -> k (a + b),
  mult (a, b) k -> k (a * b)
} handle (
  effect !const : Int ~> $r.
  effect !neg   : $r ~> $r.
  effect !plus  : $r * $r ~> $r.
  effect !mult  : $r * $r ~> $r.

  do x <- !const 2 in
  do y <- !const 4 in

  -- one sweep, seeding each input into its own gradient slot
  do (v, bp) <- with [$d -> $r * ($r -> ($r * $r)!{...})] reverse handle (
    effect !lift  : $r ~> $d.
    effect !seedx : $r ~> $d.
    effect !seedy : $r ~> $d.
    do xd <- !seedx x in
    do yd <- !seedy y in
    f (xd, yd)
  ) in

  -- the gradient is the backpropagator applied to an output sensitivity of 1
  do (dx, dy) <- bp (!const 1) in
  -- f, df/dx, df/dy at (x, y) = (2, 4)
  return (v :: dx :: dy :: [])
)

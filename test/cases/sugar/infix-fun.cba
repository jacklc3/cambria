-- An operator binding with its operands named, and one given an existing
-- function; declared operators mix with the built-in precedences.
-- @expect-type: (List Int * List Int)!{}
-- @expect-value: Pure: ([7, 1], [7, 1])
let snoc (xs, x) = return (x :: xs) in
let infixl 0 (<+) = snoc in
let infixl 0 xs +> x = return (x :: xs) in
do a <- [] <+ 1 <+ 3 + 4 in
do b <- [] +> 1 +> 3 + 4 in
return (a, b)

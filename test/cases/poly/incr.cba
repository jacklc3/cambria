-- @expect-type: Int!{ fresh : Unit ~> Name }
with [$p -> Name] handler {
  return x  -> return (fun _ -> return x),
  get a k -> return (fun s -> k (lookup (a, s)) s),
  set x k -> return (fun s -> k () (insert (x, s))),
  ref x k -> do a <- !fresh () in return (fun s ->
    k a (insert (((a, x), s)))),
  finally s -> s empty
} handle
effect !get : $p ~> Int.
effect !set : $p * Int ~> Unit.
effect !ref : Int ~> $p.
let incr r = do v <- !get r in !set (r, v + 1) in
do a <- !ref 10 in
do b <- !ref 20 in
incr a ; incr b ; incr a ;
return (!get a + !get b)
